# Anthropic API key for AI photo-to-catalog extraction.
# Without a key the app falls back to demo extraction so the flow still works.
ANTHROPIC_API_KEY=

# Vision model for product extraction. The PRD's claude-sonnet-4-20250514 is
# deprecated (retires 2026-06-15); claude-sonnet-4-6 is its replacement.
CATALOG_AI_MODEL=claude-sonnet-4-6

# Public base URL of the deployed app (used in WhatsApp share links and QR codes)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
